# Supabase → Project Settings → API → Project URL
SUPABASE_URL=

# Supabase → Project Settings → API → service_role (secret).
# Solo la usa el servidor y el script de importación; nunca llega al navegador.
SUPABASE_SERVICE_ROLE_KEY=

# Google AI Studio → Get API key. Sin ella, el botón de borrador avisa que falta.
GEMINI_API_KEY=

# Opcional. Modelo de Gemini a usar; por defecto gemini-3.6-flash.
GEMINI_MODEL=
